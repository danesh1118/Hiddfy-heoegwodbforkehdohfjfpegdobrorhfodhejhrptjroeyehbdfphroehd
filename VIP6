5.053, 4.900, 5.211, 4.991, 5.164, 4.830, 5.280, 5.016, 5.114, 4.930];
        const patternSumPerMinuteGB = pattern.reduce((a, b) => a + b, 0);

        function getConfigName(link) {
            try {
                const hashPart = link.split('#')[1];
                if (!hashPart) return 'Unknown';
                return decodeURIComponent(hashPart);
            } catch (e) {
                return 'Unknown';
            }
        }

        function randomPing() {
            return Math.floor(Math.random() * 61) + 40; // 40-100 ms
        }

        function randomLoad() {
            return Math.floor(Math.random() * 16) + 15; // 15-30 %
        }

        function buildServersTable() {
            const tbody = document.getElementById('servers-tbody');
            if (!tbody) return;
            tbody.innerHTML = '';

            serverConfigs.forEach((link, index) => {
                const name = getConfigName(link);
                const ping = randomPing();
                const load = randomLoad();

                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td>${name}</td>
                    <td>${name.split(' ')[0] || '—'}</td>
                    <td>${ping} ms</td>
                    <td>${load}%</td>
                    <td><span class="status-active">فعال</span></td>
                    <td><button class="copy-btn" onclick="copyConfig(${index})">کپی</button></td>
                `;
                tbody.appendChild(tr);
            });
        }

        function calculateUsage() {
            const now = Date.now();
            let elapsedMs = now - START_TIME;
            if (elapsedMs < 0) elapsedMs = 0;
            if (elapsedMs > PERIOD_MS) elapsedMs = PERIOD_MS;

            const elapsedSeconds = Math.floor(elapsedMs / 1000);
            const fullMinutes = Math.floor(elapsedSeconds / 60);
            const secondsInMinute = elapsedSeconds % 60;

            let totalConsumedGB = fullMinutes * patternSumPerMinuteGB;
            for (let i = 0; i < secondsInMinute; i++) {
                totalConsumedGB += pattern[i % pattern.length];
            }
            totalConsumedGB = Math.min(totalConsumedGB, MAX_VOLUME_GB);

            const consumedGB = totalConsumedGB.toFixed(4);
            const remainingGB = (MAX_VOLUME_GB - totalConsumedGB).toFixed(3);

            const timeLeftMs = PERIOD_MS - elapsedMs;
            const days = Math.max(0, Math.floor(timeLeftMs / 86400000));
            const hours = Math.floor((timeLeftMs % 86400000) / 3600000);
            const minutes = Math.floor((timeLeftMs % 3600000) / 60000);
            const seconds = Math.floor((timeLeftMs % 60000) / 1000);

            return { remainingGB, consumedGB, days, hours, minutes, seconds, totalConsumedGB };
        }

