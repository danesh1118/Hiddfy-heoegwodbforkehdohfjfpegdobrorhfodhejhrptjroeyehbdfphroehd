        const START_TIME = Date.parse('2026-09-06T17:25:00Z');
        const PERIOD_MS = 07 * 24 * 60 * 60 * 1000;
        const MAX_VOLUME_GB = 1000000;

        const pattern = [5.100, 4.887, 5.248, 5.007, 5.188, 4.842, 5.292, 4.943, 5.142, 4.827,
5.262, 5.053, 4.899, 5.211, 4.992, 5.161, 4.812, 5.275, 5.022, 5.111,
